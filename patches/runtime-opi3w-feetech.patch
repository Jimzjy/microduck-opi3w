+
+impl DerivedVelocity {
+    /// Serve the bus's own `present_speed` one control step late.
+    ///
+    /// The joint velocity a policy is trained against is one control step old
+    /// (`delay_min_lag = 1`), and the policy is optimised against exactly that. Handing it the
+    /// same number with no delay makes the damping term lead the motion instead of trail it:
+    /// measured with the corrected speed scale (50 steps per count) the leg current went from
+    /// 4742 to 5952 mA and the yaw rock grew by 29 percent. kissqy's HD-1910 runtime delays
+    /// this channel the same way (`delay_velocity`).
+    fn delay_reported(&mut self, sensors: &mut Option<duck_control::io::Sensors>) {
+        let Some(sensors) = sensors.as_mut() else {
+            return;
+        };
+        let current = sensors.velocities;
+        if self.seen_reported {
+            sensors.velocities = self.last_velocity;
+        }
+        self.last_velocity = current;
+        self.seen_reported = true;
+    }
+
+    fn apply(&mut self, sensors: &mut Option<duck_control::io::Sensors>, dt: f64) {
+        let Some(sensors) = sensors.as_mut() else {
+            return;
+        };
+        if !(dt > 0.0) {
+            return;
+        }
+        if let Some(previous) = self.last_positions {
+            let mut measured = [0.0; NUM_JOINTS];
+            for (i, measured) in measured.iter_mut().enumerate() {
+                *measured = (sensors.positions[i] - previous[i]) / dt;
+            }
+            sensors.velocities = self.last_velocity;
+            self.last_velocity = measured;
+        }
+        self.last_positions = Some(sensors.positions);
+    }
