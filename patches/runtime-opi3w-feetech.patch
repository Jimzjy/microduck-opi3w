diff --git a/robotd/src/dump.rs b/robotd/src/dump.rs
new file mode 100644
index 0000000..8608995
--- /dev/null
+++ b/robotd/src/dump.rs
@@ -0,0 +1,45 @@
+//! Diagnostic dump of policy inputs and outputs.
+//!
+//! Off unless `MICRODUCK_DUMP` names a file. Written for one investigation (why the
+//! sitstand network asks for joint targets twice the mechanical travel) and kept because
+//! the next one will want it: the observation is the only thing a policy is told, and
+//! nothing on the wire shows it.
+//!
+//! One JSON object per control tick, appended and flushed, so a run that ends in a
+//! brown-out still leaves what it wrote on disk.
+
+use std::io::Write as _;
+use std::sync::{Mutex, OnceLock};
+
+fn sink() -> &'static Mutex<Option<std::fs::File>> {
+    static SINK: OnceLock<Mutex<Option<std::fs::File>>> = OnceLock::new();
+    SINK.get_or_init(|| {
+        let file = std::env::var("MICRODUCK_DUMP").ok().and_then(|path| {
+            std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(path)
+                .map_err(|error| {
+                    tracing::warn!(%error, "dump file will not open; not dumping");
+                    error
+                })
+                .ok()
+        });
+        Mutex::new(file)
+    })
+}
+
+/// Append one tick. A no-op unless the dump file is configured.
+pub fn record(net: &str, obs: &[f32], action: &[f32]) {
+    let Ok(mut guard) = sink().lock() else { return };
+    let Some(file) = guard.as_mut() else { return };
+    let obs: Vec<String> = obs.iter().map(|value| format!("{value:.5}")).collect();
+    let action: Vec<String> = action.iter().map(|value| format!("{value:.5}")).collect();
+    let _ = writeln!(
+        file,
+        "{{\"net\":\"{net}\",\"obs\":[{}],\"action\":[{}]}}",
+        obs.join(","),
+        action.join(",")
+    );
+    let _ = file.flush();
+}
