+                bench.answer(Err(text));
+                return None;
+            }
+            commissioning::VerifyStep::Done(mount) => {
+                let result = store_imu_mount(state, mount);
+                bench.answer(result.map(|()| {
+                    serde_json::json!({
+                        "imu_mount": { "quat": mount, "verified": true },
+                    })
+                }));
+                return None;
+            }
+        }
+        return Some(bench);
+    }
+
+    None
+}
