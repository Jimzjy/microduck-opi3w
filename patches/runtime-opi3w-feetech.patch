+                    slot.to_owned(),
+                    serde_json::json!({
+                        "file": file,
+                        "runtime_execution_profile": "onboard",
+                    }),
+                );
+            }
+        };
+        put("walk", &names.walk);
+        put("stand", &names.stand);
+        put("sitstand", &names.sitstand);
+        put("ground_pick", &names.ground_pick);
+        for skill in &names.skills {
+            put(skill, &Some(skill.clone()));
+        }
+        serde_json::Value::Object(models)
+    }
