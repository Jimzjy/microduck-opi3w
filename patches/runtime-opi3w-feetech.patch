+    #[test]
+    fn a_nonsense_tilt_is_never_a_success() {
+        let mut verify = Verify::begin([1.0, 0.0, 0.0, 0.0]);
+        verify.step(TICK, 0.0, [0.0, 0.0, -1.0]);
+        assert_eq!(verify.step(TICK, f64::NAN, [f64::NAN; 3]), VerifyStep::Waiting);
+    }
