+    // would be a pose falling over 鈥?and Studio's own rule is that relax is how you get out.
+    // opi3w: Studio's coarse redo flow verifies limp (the recalibrate session keeps torque off
+    // on purpose), so only an actual hold 鈥?a pose that falls over without torque 鈥?is refused.
+    if state.torque_state.load(Ordering::Relaxed) == 2 && bench.hold.is_some() {
+        state.hold_stage.store(0, Ordering::Relaxed);
+        bench.answer(Err(
+            "relax was pressed while the robot was holding: nothing is holding the pose now, so \
+             it cannot be calibrated. Nothing saved."
+                .to_owned(),
+        ));
+        return None;
+    }
+
+    // The numbers are read out of the hold before its borrow ends, because answering needs the
+    // whole `Bench` 鈥?the reply channel lives beside the hold, not inside it.
+    let mut holding: Option<(bool, f64, &'static str)> = None;
+    if let Some(hold) = bench.hold.as_mut() {
+        let positions = sensors.map(|sensors| sensors.positions).unwrap_or(*targets);
+        *targets = hold.step(dt, &positions);
+        let arrived = hold.stage() == "holding";
+        state
+            .hold_stage
+            .store(if arrived { 2 } else { 1 }, Ordering::Relaxed);
+        if arrived {
+            state
+                .hold_error_deg
+                .store(hold.max_error_deg().to_bits(), Ordering::Relaxed);
+        }
+        holding = Some((hold.settled(), hold.max_error_deg(), hold.stage()));
+    }
+    if let Some((settled, error, stage)) = holding {
+        if settled && bench.reply.is_some() {
+            if error > commissioning::HOLD_ERROR_TOLERANCE_DEG {
+                // Not a hold worth calibrating on, and continuing to push a joint that cannot
+                // get there is how a servo gets hot. Give the pose up and say why.
+                state.hold_stage.store(0, Ordering::Relaxed);
+                bench.answer(Err(format!(
+                    "the joints are still {error:.1}掳 from home, past the {:.0}掳 a calibration \
+                     can be taken on: check for a blocked joint, then relax the robot and try \
+                     again. Nothing saved.",
+                    commissioning::HOLD_ERROR_TOLERANCE_DEG
+                )));
+                return None;
+            }
+            bench.answer(Ok(serde_json::json!({
+                "stage": stage,
+                "max_error_deg": error,
+            })));
+        }
+        return Some(bench);
+    }
+
+    if let Some(verify) = bench.verify.as_mut() {
+        let Some(sensors) = sensors else {
+            bench.answer(Err(
+                "verify-imu needs a live IMU sample and the bus has not produced one: check the \
+                 IMU board on the bus and try again. Nothing saved."
+                    .to_owned(),
+            ));
+            return None;
+        };
+        // opi3w: the gesture confirms a mount, so it has to be judged in the frame it proposes.
+        // While the stored mount is wrong 鈥?a board screwed on a different way and never verified,
+        // so still the body default 鈥?even a perfectly upright robot reads ~90掳 and no pose can
+        // pass, which is what made this fail however the robot was held. Studio's coarse flow
+        // exists precisely for that robot, so the candidate frame is what the gesture is about.
+        let candidate = verify.mount();
+        let calibration = state.calibration.load_full();
+        let in_use = active_imu_mount(bus, state.board, calibration.as_deref());
+        let gravity = duck_control::imu::remount_gravity(sensors.imu.gravity, in_use, candidate);
+        let tilt = tilt_deg_of(gravity);
