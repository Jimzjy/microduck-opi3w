// audio-a733.dts — A733 外挂 TLV320AIC3104 音频 overlay（HAT codec）
//
// 基础：Armbian trixie vendor 6.6.98（sun60i-a733-orangepi-zero3w.dtb），
// 源码 orangepi-xunlong/linux-orangepi 分支 orange-pi-6.6-sun60iw2。
//
// 板级 dts 现状（2026-10-27 实测核对）：
//   - &twi0（twi@2510000，PB2/PB3 = 排针 5/3，400kHz）status="disabled"
//   - &i2s0_plat（i2s0_plat@2532000，PB4-PB8 = 排针 7/12/35/38/40）status="disabled"
//   - &i2s0_mach（挂在 /soc@3000000 下）status="okay"，其 codec 子节点
//     i2s0_codec 的 sound-dai 指向板载 &ac101 —— 我们不用 AC101，overlay
//     把 sound-dai 改指向本 overlay 新增的 aic3104 节点（fdtoverlay 的
//     __local_fixups__ 会把 overlay 内部 phandle 引用修正，无需基础 dtb 符号表）。
//
// 不做的事（fdtoverlay 只能合并属性，不能删除，全用覆盖）：
//   - 不删 i2s0_mach 里 AC101 的 pin-switches / routing：留原值只会在 ALSA
//     卡片上多出找不到对应控件的声明（非致命）；控件名核对后上板再精调。
//
// 上板前必核（标记 TODO-BOARD）：
//   1. tlv320aic31xx 驱动是否真编进 Armbian vendor 6.6.98 内核/模块
//      （grep snd-soc-tlv320aic31xx /lib/modules/…/ 或 /proc/config.gz 的
//      CONFIG_SND_SOC_TLV320AIC31XX）。
//   2. aic3104 的 DAPM 控件名，据实把 routing/pin-switches 覆盖成正确值。
//   3. our HAT 的 MCLK 来自板上 Y1 12MHz 有源晶振（不经排针），codec DT 节点
//     不需要 SoC 时钟引用；若驱动 probe 报缺 mclk，再补 fixed-clock。

/dts-v1/;
/plugin/;

&{/soc@3000000/twi@2510000} {
	// 与基础 dtb twi0 的 #address-cells/#size-cells（1/0）一致，仅为消
	// dtc 静态检查对 fragment 内 reg 的警告，应用后不改变父节点行为。
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	aic3104: tlv320aic3104@18 {
		compatible = "ti,tlv320aic3104";
		reg = <0x18>;
		#sound-dai-cells = <0>;
		status = "okay";
	};
};

&{/soc@3000000/i2s0_plat@2532000} {
	status = "okay";
};

&{/soc@3000000/i2s0_mach} {
	soundcard-mach,name = "aic3104-hat";

	// soundcard-mach,cpu 不动：基础 dtb 里 sound-dai 已正确指向 i2s0_plat，
	// overlay 无法为基础 dtb 节点生成 phandle，不要在这里引用它。

	soundcard-mach,codec {
		sound-dai = <&aic3104>;
	};
};
